# =============================================================
# KAS Supplements — Backend Environment Variables
# =============================================================
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio.
# =============================================================

# ── Servidor ──────────────────────────────────────────────────
PORT=8080
# development | production
NODE_ENV=development

# ── Base de datos (PostgreSQL via Prisma) ─────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/supplements_db?schema=public"

# ── CORS — URL del frontend ───────────────────────────────────
# Dev:  http://localhost:5173
# Prod: https://kassupplements.com
CORS_ORIGIN=http://localhost:5173

# ── URL pública del frontend ──────────────────────────────────
# Usada para construir las back_urls de Mercado Pago.
# Dev:  deja vacío (config.js usa localhost:5173 por defecto)
# Prod: tu dominio real (sin trailing slash)
FRONTEND_URL=https://kassupplements.com

# ── JWT ───────────────────────────────────────────────────────
# Genera un secreto fuerte: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_openssl_rand_hex_64

# ── Panel AdminJS ─────────────────────────────────────────────
ADMIN_EMAIL=admin@kassupplements.com
ADMIN_PASSWORD=CHANGE_ME_strong_password
# Genera un secreto fuerte: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32

# ── Mercado Pago — App 1: Pagos únicos (Checkout Bricks) ─────
# Obtén tus credenciales en: https://www.mercadopago.com.mx/developers/panel/app
# TEST (sandbox): APP_USR-xxxx... | LIVE: tu token de producción
MERCADOPAGO_ACCESS_TOKEN=APP_USR-XXXX-LIVE-ACCESS-TOKEN

# Webhook Secret de la App 1 (pagos únicos)
# Cópialo desde: MP Panel → App de pagos → Webhooks → Clave secreta
# Endpoint que debe configurar en MP: <PUBLIC_URL>/api/v1/webhooks/mp
MP_WEBHOOK_SECRET=CHANGE_ME_mp_payments_webhook_secret

# ── Mercado Pago — App 2: Suscripciones (Preapproval) ────────
# Si usas la misma app, pon el mismo token. Si son apps separadas (recomendado),
# usa el token de la app de suscripciones.
MP_SUBSCRIPTION_TOKEN=APP_USR-XXXX-SUBSCRIPTION-ACCESS-TOKEN

# Webhook Secret de la App 2 (suscripciones)
# Cópialo desde: MP Panel → App de suscripciones → Webhooks → Clave secreta
# Endpoint configurado en MP: <PUBLIC_URL>/api/v1/webhooks/mp-subscriptions
# Este secret también se envía como notification_url en cada preapproval creado.
MP_SUBSCRIPTION_WEBHOOK_SECRET=CHANGE_ME_mp_subscriptions_webhook_secret

# ── URL pública del backend ───────────────────────────────────
# Usada para construir notification_url en preapprovals y back_urls.
# Dev:  túnel ngrok (cambia con cada reinicio; usa ngrok http 8080)
# Prod: URL de Railway sin trailing slash
PUBLIC_URL=https://api.kassupplements.com

# ── Resend (Email) ────────────────────────────────────────────
# Obtén tu API key en: https://resend.com/api-keys
RESEND_API_KEY=re_XXXX
# Remitente verificado en Resend (dominio propio en prod)
RESEND_FROM=KAS Supplements <noreply@kassupplements.com>
# Solo en dev (sin dominio verificado): todos los emails van a este correo
RESEND_DEV_TO=tu_correo@ejemplo.com
